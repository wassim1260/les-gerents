# Hotel Transport Management System - Environment Configuration

# ==============================================
# APPLICATION
# ==============================================
APP_NAME="Hotel Transport Management"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_URL=http://localhost

# ==============================================
# MYSQL DATABASE
# ==============================================
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotel_transport
DB_USERNAME=hotel_user
DB_PASSWORD=hotel_pass
DB_ROOT_PASSWORD=root_password

# ==============================================
# MONGODB DATABASE
# ==============================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=hotel_transport_logs
MONGO_USERNAME=mongo_admin
MONGO_PASSWORD=mongo_pass

# ==============================================
# REDIS CACHE
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=604800

# ==============================================
# LARAVEL BACKEND
# ==============================================
LARAVEL_APP_KEY=
LARAVEL_APP_URL=http://localhost:8000
LARAVEL_API_URL=http://localhost:8000/api

# ==============================================
# NODE.JS BACKEND
# ==============================================
NODE_ENV=development
NODE_PORT=3001
NODE_API_URL=http://localhost:3001/api

# ==============================================
# PHP BACKEND
# ==============================================
PHP_PORT=8080
PHP_API_URL=http://localhost:8080/api

# ==============================================
# FRONTEND URLS
# ==============================================
REACT_APP_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_NODE_API_URL=http://localhost:3001/api
REACT_APP_WS_URL=ws://localhost:3001

ANGULAR_APP_URL=http://localhost:4200
ANGULAR_API_URL=http://localhost:8000/api
ANGULAR_NODE_API_URL=http://localhost:3001/api
ANGULAR_WS_URL=ws://localhost:3001

NEXTJS_APP_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_NODE_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@hoteltransport.ma
MAIL_FROM_NAME="HTM Transport"

# ==============================================
# SMS CONFIGURATION (Example: Twilio)
# ==============================================
SMS_PROVIDER=twilio
SMS_API_KEY=your-twilio-account-sid
SMS_API_SECRET=your-twilio-auth-token
SMS_FROM_NUMBER=+212XXXXXXXXX
SMS_ENABLED=true

# Alternative: Other SMS providers
# SMS_PROVIDER=nexmo
# SMS_PROVIDER=vonage
# SMS_PROVIDER=africastalking

# ==============================================
# GOOGLE MAPS API
# ==============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_ENABLED=true

# ==============================================
# PAYMENT GATEWAY
# ==============================================
PAYMENT_GATEWAY=stripe
PAYMENT_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
PAYMENT_CURRENCY=MAD

# Alternative payment gateways for Morocco
# PAYMENT_GATEWAY=cmi
# PAYMENT_GATEWAY=maroc_telecommerce
# PAYMENT_GATEWAY=paypal

# ==============================================
# N8N WORKFLOW AUTOMATION
# ==============================================
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_TIMEZONE=Africa/Casablanca

# ==============================================
# FILE UPLOADS
# ==============================================
UPLOAD_MAX_SIZE=5242880
UPLOAD_PATH=/var/www/uploads
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf

# ==============================================
# SECURITY
# ==============================================
SESSION_LIFETIME=120
SESSION_DRIVER=redis
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:3002
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# LOGGING
# ==============================================
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_MONGODB_ENABLED=true

# ==============================================
# BACKUP
# ==============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# ==============================================
# NOTIFICATIONS
# ==============================================
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_WEBSOCKET_ENABLED=true

# ==============================================
# ANALYTICS
# ==============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
ANALYTICS_ENABLED=false

# ==============================================
# SOCIAL MEDIA
# ==============================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================
# BUSINESS CONFIGURATION
# ==============================================
COMPANY_NAME="Hotel Transport Management"
COMPANY_EMAIL=contact@hoteltransport.ma
COMPANY_PHONE="+212 5XX-XXXXXX"
COMPANY_ADDRESS="Casablanca, Morocco"
COMPANY_WEBSITE=https://hoteltransport.ma

# Booking Configuration
BOOKING_ADVANCE_HOURS=2
CANCELLATION_FREE_HOURS=6
MAX_BOOKING_DAYS=90

# Pricing Configuration
SERVICE_FEE_PERCENTAGE=10
VAT_PERCENTAGE=20
CURRENCY=MAD
CURRENCY_SYMBOL="MAD"

# Driver Configuration
DRIVER_APPROVAL_REQUIRED=true
DRIVER_BACKGROUND_CHECK=true
DRIVER_MIN_RATING=3.5

# ==============================================
# TIMEZONE & LOCALE
# ==============================================
TIMEZONE=Africa/Casablanca
LOCALE=fr
FALLBACK_LOCALE=en
SUPPORTED_LOCALES=fr,en,ar

# ==============================================
# DEVELOPMENT & DEBUG
# ==============================================
APP_DEBUG=true
DEBUG_QUERIES=false
TELESCOPE_ENABLED=false

# ==============================================
# DOCKER COMPOSE CONFIGURATION
# ==============================================
COMPOSE_PROJECT_NAME=hotel_transport
DOCKER_RESTART_POLICY=unless-stopped

# ==============================================
# SSL/TLS (Production)
# ==============================================
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ==============================================
# CDN (Production)
# ==============================================
CDN_ENABLED=false
CDN_URL=https://cdn.hoteltransport.ma

# ==============================================
# QUEUE CONFIGURATION
# ==============================================
QUEUE_CONNECTION=redis
QUEUE_DRIVER=redis

# ==============================================
# BROADCASTING
# ==============================================
BROADCAST_DRIVER=redis
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# ==============================================
# CACHE
# ==============================================
CACHE_DRIVER=redis
CACHE_TTL=3600

# ==============================================
# MONITORING (Optional)
# ==============================================
SENTRY_DSN=
SENTRY_ENABLED=false

# ==============================================
# API RATE LIMITING
# ==============================================
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=1

# ==============================================
# MAINTENANCE MODE
# ==============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site en maintenance. Retour prévu bientôt."

# ==============================================
# NOTES
# ==============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control
# 3. Keep your secrets secure
# 4. Update JWT_SECRET, DB passwords, and API keys before production
# 5. For production, set APP_DEBUG=false and APP_ENV=production
